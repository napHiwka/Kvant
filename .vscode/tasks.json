{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Server",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/dev/server.py"
      ],
      "isBackground": true,
      "problemMatcher": [],
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      }
    },
    {
      "label": "Loadstring",
      "type": "shell",
      "command": "python",
      "args": [
        "${workspaceFolder}/dev/loadstring.py",
        "${relativeFile}"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
